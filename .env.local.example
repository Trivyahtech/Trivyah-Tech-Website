# Contact form (EmailJS). Copy this file to .env.local and fill in.
# Same values as the Vercel project "v0-trivia-tech-website" (Settings > Environment Variables),
# or from emailjs.com > Account (public key), Email Services (service ID), Email Templates (template ID).
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
